# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Owner alert phone number
OWNER_PHONE_NUMBER=+1...

# Bridge script API key (generate with: openssl rand -hex 32)
BRIDGE_API_KEY=your-64-char-key

# App
NEXT_PUBLIC_APP_URL=https://parkinboulder.com

# Analytics & SEO (all optional — features activate when set)
# GA4 measurement id (G-XXXXXXXXXX); enables gtag + purchase conversion event
NEXT_PUBLIC_GA_ID=
# Google Search Console meta-tag verification token (content attr value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# GBP "write a review" short link; enables review link on /pay/success
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
# Same link, used server-side for the SMS review request (requires Twilio)
GOOGLE_REVIEW_URL=
